{% comment %}
  Featured products section for Kindred Coffee Roasters.
  Editorial-style product showcase with lifestyle imagery.
{% endcomment %}

<div class="featured-products" style="--color-background: {{ section.settings.color_scheme.background }}; --color-text: {{ section.settings.color_scheme.text }}">
  <div class="featured-products__header">
    {% if section.settings.eyebrow != blank %}
      <p class="featured-products__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.headline != blank %}
      <h2 class="featured-products__headline">{{ section.settings.headline }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="featured-products__description">{{ section.settings.description }}</div>
    {% endif %}
    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="featured-products__link">
        {{ section.settings.view_all_text | default: 'View all coffee' }}
        <svg class="icon icon--arrow-right" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
      </a>
    {% endif %}
  </div>

  <div class="featured-products__grid" role="list">
    {% for product in section.settings.collection.products limit: section.settings.products_limit %}
      <article class="featured-products__item" role="listitem">
        <div class="featured-products__media">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600, height: 750 | image_tag: loading: "lazy", sizes: "(max-width: 749px) 100vw, (max-width: 1199px) 50vw, 33vw" }}
            {% else %}
              <div class="featured-products__placeholder"></div>
            {% endif %}
          </a>
          {% if product.compare_at_price > product.price %}
            <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
          {% endif %}
        </div>
        <div class="featured-products__info">
          <h3 class="featured-products__title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          {% if product.metafields.custom.tasting_notes != blank %}
            <p class="featured-products__tasting-notes">{{ product.metafields.custom.tasting_notes }}</p>
          {% endif %}
          <div class="featured-products__price">
            <span class="price price--regular">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="price price--compare">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
        </div>
      </article>
    {% else %}
      {% for i in (1..section.settings.products_limit) %}
        <article class="featured-products__item featured-products__item--placeholder" role="listitem" aria-hidden="true">
          <div class="featured-products__media">
            <div class="featured-products__placeholder"></div>
          </div>
          <div class="featured-products__info">
            <h3 class="featured-products__title skeleton"></h3>
            <p class="featured-products__tasting-notes skeleton"></p>
            <div class="featured-products__price skeleton"></div>
          </div>
        </article>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .featured-products {
    padding: 80px 24px;
  }

  .featured-products__header {
    max-width: 1200px;
    margin: 0 auto 48px;
    text-align: left;
  }

  .featured-products__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C97B3C;
    margin: 0 0 12px;
  }

  .featured-products__headline {
    font-family: var(--font-heading-family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 16px;
  }

  .featured-products__description {
    font-size: 1rem;
    line-height: 1.7;
    color: color_mix(var(--color-text), transparent 35%);
    max-width: 520px;
    margin: 0 0 24px;
  }

  .featured-products__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }

  .featured-products__link:hover {
    gap: 12px;
    opacity: 0.7;
  }

  .featured-products__link .icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    stroke: currentColor;
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-products__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .featured-products__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: color_mix(var(--color-background), var(--color-text) 5%);
    margin-bottom: 20px;
  }

  .featured-products__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-products__item:hover .featured-products__media img {
    transform: scale(1.03);
  }

  .featured-products__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, color_mix(var(--color-background), var(--color-text) 5%) 0%, color_mix(var(--color-background), var(--color-text) 12%) 100%);
  }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 9999px;
    background: var(--color-text);
    color: var(--color-background);
  }

  .badge--sale {
    background: #C97B3C;
    color: #2D1B15;
  }

  .featured-products__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .featured-products__title {
    font-family: var(--font-heading-family);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0;
    transition: color 0.2s ease;
  }

  .featured-products__item:hover .featured-products__title {
    color: #C97B3C;
  }

  .featured-products__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-products__tasting-notes {
    font-size: 0.875rem;
    line-height: 1.5;
    color: color_mix(var(--color-text), transparent 45%);
    margin: 0;
    font-style: italic;
  }

  .featured-products__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 4px;
  }

  .price--regular {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .price--compare {
    font-size: 1rem;
    font-weight: 400;
    color: color_mix(var(--color-text), transparent 50%);
    text-decoration: line-through;
  }

  /* Skeleton loading states */
  .skeleton {
    background: linear-gradient(90deg, color_mix(var(--color-background), var(--color-text) 5%) 25%, color_mix(var(--color-background), var(--color-text) 12%) 50%, color_mix(var(--color-background), var(--color-text) 5%) 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: 4px;
  }

  .featured-products__title.skeleton {
    height: 1.5rem;
    width: 70%;
  }

  .featured-products__tasting-notes.skeleton {
    height: 1rem;
    width: 50%;
  }

  .featured-products__price.skeleton {
    height: 1.5rem;
    width: 40%;
  }

  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (max-width: 749px) {
    .featured-products {
      padding: 60px 16px;
    }
    .featured-products__header {
      margin-bottom: 32px;
    }
    .featured-products__grid {
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "class": "featured-products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Seasonal Selection"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Coffee worth waking up for"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Each coffee is sourced from trusted partners and roasted to highlight its unique character.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "View all coffee"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "unit": "pcs"
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Homepage"
    }
  ]
}
{% endschema %}